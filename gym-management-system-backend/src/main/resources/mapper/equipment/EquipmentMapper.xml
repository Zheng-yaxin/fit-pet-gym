<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.modules.equipment.mapper.EquipmentMapper">

    <resultMap id="BaseResultMap" type="com.gym.modules.equipment.domain.entity.Equipment">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="category_id" property="categoryId"/>
        <result column="brand" property="brand"/>
        <result column="model" property="model"/>
        <result column="image_url" property="imageUrl"/>
        <result column="buy_date" property="buyDate"/>
        <result column="price" property="price"/>
        <result column="location" property="location"/>
        <result column="current_manager_id" property="currentManagerId"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM gym_equipment
        WHERE deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (name LIKE CONCAT('%', #{keyword}, '%') OR code LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="categoryId != null">
            AND category_id = #{categoryId}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="currentManagerId != null">
            AND current_manager_id = #{currentManagerId}
        </if>
        ORDER BY update_time DESC
    </select>

</mapper>